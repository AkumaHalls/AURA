DONO_ID=seu_id_discord
OWNER_ID=seu_id_discord
TEST_GUILD_ID=id_do_servidor_para_testes

# Clash of Clans API
COC_EMAIL=email_clash_of_clans
COC_PASSWORD=senha_clash_of_clans
CLAN_TAG=#tag_do_cla

# MongoDB / Web Panel
# Se usar Docker Compose: substitua "host" por "mongodb" (nome do serviço)
# Se rodar direto na VPS: use "127.0.0.1" (MongoDB precisa estar instalado e rodando)
MONGO_URI=mongodb://usuario:senha@host:27017/?authSource=admin
# Exemplo Docker: mongodb://usuario:senha@mongodb:27017/?authSource=admin
# Exemplo VPS:   mongodb://usuario:senha@127.0.0.1:27017/?authSource=admin
MONGO_DB_NAME=aura_bot
WEB_PANEL_PASSWORD=senha_do_painel

