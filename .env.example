# Segredos de produção. NÃO versionar: este arquivo é só o modelo.
#
#   cp .env.example .env
#
# O `.env` está no `.gitignore`. Confira antes de commitar.

# ---------- Discord ----------
# Token do bot em https://discord.com/developers/applications
DISCORD_TOKEN=

# ID do servidor onde os comandos devem aparecer na hora, durante o
# desenvolvimento. Com linha global, o comando só aparece depois da propagação.
TEST_GUILD_ID=

# Donos do AURA: acesso total ao painel e aos comandos sensíveis.
# Vários IDs separados por vírgula.
OWNER_ID=

# ---------- Banco de dados ----------
# Prefira TLS e autenticação. Nunca aponte para um MongoDB público sem senha.
MONGO_URI=mongodb://usuario:senha@host:27017/?authSource=admin
MONGO_DB_NAME=aura_bot

# Só usado pelo docker-compose, quando o Mongo roda como serviço dele.
# Nesse caso, a URI precisa apontar para o serviço e usar estas credenciais:
#   MONGO_URI=mongodb://aura:SUA_SENHA@mongo:27017/?authSource=admin
MONGO_USER=aura
MONGO_PASSWORD=

# ---------- Painel web ----------
# Gere a senha assim:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('SUA_SENHA'))"
WEB_PANEL_PASSWORD_HASH=

# Assinatura dos cookies de sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEB_PANEL_SECRET_KEY=

WEB_PANEL_HOST=0.0.0.0
WEB_PANEL_PORT=2501

# Se deixar o WEB_PANEL_PASSWORD_HASH vazio na primeira subida, o AURA gera uma
# senha aleatória, mostra no console uma única vez e grava o hash aqui. Use
# WEB_PANEL_PASSWORD só como atalho para gerar o hash no primeiro boot.

# ---------- Integração Clash of Clans ----------
# Opcional: só para o módulo "Jogos / Clash of Clans".
COC_EMAIL=
COC_PASSWORD=

# ---------- assorted ----------
# Onde ficam os bancos de perguntas por servidor (provas_<id>.json).
# Fora do Docker, a raiz do projeto já serve.
AURA_DATA_DIR=

TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Configurações legadas do AURA de servidor único.
#
# O AURA agora guarda a configuração de cada servidor no MongoDB e se edita
# pelo painel web. Essas variáveis NÃO são mais lidas em tempo de execução —
# elas só servem como ponto de partida para a importação única feita em
# Configurações → "Migrar do .env antigo". Depois da migração, apague-as.
#
# id_canal_suporte=
# id_cargo_atendente=
# id_canal_logs_bh=
# id_canal_logs_tri=
# ID_CANAL_TRANSCRICOES=
# CANAL_REGISTRO_ID=
# REGISTRATION_CHANNEL_ID=
# LOG_CHANNEL_ID=
# CARGO_MEMBRO_ID=
# CARGO_BANIDO_ID=
# APPROVAL_LOG_CHANNEL_ID=
# CLAN_TAG=
# KICK_MESSAGE=
# DONO_ID=
# ---------------------------------------------------------------------------